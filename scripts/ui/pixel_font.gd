    ")": ["01000","00100","00010","00010","00010","00100","01000"],
    "*": ["00000","10101","01110","11111","01110","10101","00000"],
}

static func measure(message: String, scale: int = 1) -> int:
    if message.is_empty():
        return 0
    return (message.length() * 6 - 1) * scale

static func paint(canvas: CanvasItem, message: String, where: Vector2, ink: Color, scale: int = 1) -> void:
    var x := roundi(where.x)
    var y := roundi(where.y)
    for ch in message.to_upper():
        var glyph: Array = GLYPHS.get(ch, GLYPHS["?"])
        for row in range(7):
            var bits: String = glyph[row]
            for col in range(5):
                if bits.substr(col, 1) == "1":
                    canvas.draw_rect(Rect2(x + col * scale, y + row * scale, scale, scale), ink)
        x += 6 * scale
